NODE_ENV=development
HOST=127.0.0.1
PORT=3001
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>/vybe_dev?retryWrites=true&w=majority
WEB_ORIGIN=http://127.0.0.1:5173
VYBE_DEV_DB_NAME=vybe_dev
VYBE_DEV_TENANT_SLUG=community
VYBE_PLATFORM_TENANT_SLUG=community
# Comma-separated account e-mails allowed to review new community requests.
# Keep this server-side; never expose it through the web app.
VYBE_PLATFORM_ADMIN_EMAILS=admin@example.com
# Username of the official central VYBE character available inside each tenant.
VYBE_VERIFICATION_ADMIN_USERNAME=vybea
VYBE_DEMO_PASSWORD=replace-with-a-development-only-password
