{
  "name": "@vybe/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "db:init": "node --import tsx src/scripts/init-db.ts",
    "db:migrate:account-profile": "node --import tsx src/scripts/migrate-account-profile.ts",
    "db:migrate:vybe-plus-beneficiaries": "node --import tsx src/scripts/migrate-vybe-plus-beneficiaries.ts",
    "db:migrate:community-creation-billing": "node --import tsx src/scripts/migrate-community-creation-billing.ts",
    "db:migrate:message-server-settings": "node --import tsx src/scripts/migrate-message-server-settings.ts",
    "db:seed": "node --import tsx src/scripts/seed.ts",
    "db:seed:social-demo": "node --import tsx src/scripts/seed-social-demo.ts",
    "db:seed:match-demo": "node --import tsx src/scripts/seed-match-demo.ts",
    "db:seed:messages-demo": "node --import tsx src/scripts/seed-messages-demo.ts",
    "db:seed:match-incoming-like": "node --import tsx src/scripts/seed-match-incoming-like.ts",
    "test": "node --import tsx --test src/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@vybe/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "mongoose": "^8.18.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
